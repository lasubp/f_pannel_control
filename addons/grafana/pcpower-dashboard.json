        "definition": "label_values(pcpower_daemon_up, instance)",
        "query": {
          "query": "label_values(pcpower_daemon_up, instance)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
