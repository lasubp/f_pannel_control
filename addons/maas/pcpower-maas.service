[Unit]
Description=Optional MAAS Webhook adapter for pcpowerd
Requires=pcpowerd.service
After=pcpowerd.service

[Service]
Type=simple
User=pcpower
Group=pcpower
ExecStart=/opt/pcpower/venv/bin/python /opt/pcpower/pcpower_maas.py --listen 0.0.0.0 --port 8765 --socket /run/pcpower/control.sock --token-file /etc/pcpower/maas-token
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
