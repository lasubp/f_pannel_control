[Unit]
Description=PC Power Hardware Controller
After=local-fs.target

[Service]
Type=simple

User=pcpower
Group=pcpower
SupplementaryGroups=i2c

WorkingDirectory=/opt/pcpower

RuntimeDirectory=pcpower
RuntimeDirectoryMode=0770

UMask=0007

ExecStartPre=/opt/pcpower/venv/bin/python \
    /opt/pcpower/pcpowerd.py \
    --check

ExecStart=/opt/pcpower/venv/bin/python \
    /opt/pcpower/pcpowerd.py

Restart=on-failure
RestartSec=2

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
